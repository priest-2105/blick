# Supabase project URL and publishable (anon) key.
# Required for sign-in, cloud saves, and syncing workshop projects.
# Without these, the app still works fully in local-only mode (drafts saved to localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key (server-only, never expose to the client).
# Required only for the "Delete account" flow (src/app/api/account/delete/route.ts).
# Without it, account deletion returns a clean 501 instead of deleting the user.
SUPABASE_SERVICE_ROLE_KEY=
